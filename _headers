# Netlify reads this from the publish directory — no build step needed.
#
# Without it Netlify serves EVERY asset as `public,max-age=0,must-revalidate`,
# so a repeat visitor re-round-trips ~20 photos, the CSS and the JS on every
# single page view.
#
# 30 days, deliberately NOT `immutable`: filenames are unfingerprinted camera
# IDs (DSC09686.jpg), so a re-exported photo reusing a name would otherwise sit
# stale in browsers for a year with no way to bust it.

/images/*
  Cache-Control: public, max-age=2592000

/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Applies to every response. Two cheap, zero-risk additions:
#  - nosniff stops MIME sniffing on the .md paths _redirects 404s.
#  - Referrer-Policy: without it the full URL of the page a visitor was on leaks
#    to the booking host and to every outbound link, which sits badly next to
#    publishing a privacy page.
# Deliberately NOT adding Content-Security-Policy: this site uses inline
# background-image styles, inline JSON-LD and a third-party booking embed, so a
# correct policy needs 'unsafe-inline' (defeating most of the point) plus a host
# allowlist that breaks the booking flow the day HoneyBook changes CDN.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
